# Primary TTS Engine: Azure Speech (Recommended for studio-quality bn-BD voices)
# Get a free API key at: https://azure.microsoft.com/en-us/products/ai-foundry/tools/speech
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# Alternative: Google Gemini Speech API
# Get an API key at: https://aistudio.google.com
GEMINI_API_KEY=

# Alternative: ElevenLabs Bengali / English
# Get an API key at: https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
